# Everything the image does not need. Keeps the context small and prevents a
# stray local venv or .pytest_cache from busting the build cache.
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
tests/
*.md
.env
.env.*
.git/
.gitignore
Dockerfile
.dockerignore
